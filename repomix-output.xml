          disabled={salvando}
          className="w-full bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold p-3.5 rounded-xl transition flex items-center justify-center gap-2 mt-6 shadow-lg"
        >
          <Save size={18} />
          {salvando ? "A guardar..." : "Salvar Alterações"}
        </button>
      </form>
    </main>
  );
}
