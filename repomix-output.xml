    const novasMusicas = [...musicasAtuais, musicaId];

    const urlPatch = `https://firestore.googleapis.com/v1/projects/${projectId}/databases/(default)/documents/repertorios/${repertorioId}?updateMask.fieldPaths=musicasIds`;

    const bodyData = {
